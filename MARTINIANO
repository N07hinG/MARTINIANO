<style>
:root{--bg:#f4f5f7;--card:#fff;--ink:#0f172a;--mut:#64748b;--line:#e5e7eb;--g:#22c55e;--r:#ef4444}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.45 Inter,"Segoe UI",system-ui,-apple-system,sans-serif;padding-bottom:64px}
main{max-width:920px;margin:0 auto;padding:8px 14px}
.i,i svg{width:1.15em;height:1.15em;flex:none}i{display:inline-flex}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px;margin:14px 0;box-shadow:0 1px 2px rgba(15,23,42,.04),0 8px 24px rgba(15,23,42,.04)}
h2{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);margin:0 0 14px}
button,.btn{font:inherit;font-weight:600;min-height:60px;border:1px solid var(--line);border-radius:14px;padding:0 18px;background:#fff;color:var(--ink);box-shadow:0 1px 2px rgba(15,23,42,.06);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;margin:5px 0;transition:.15s}
button:hover,.btn:hover{border-color:#cbd5e1;box-shadow:0 4px 12px rgba(15,23,42,.08)}
button:active{transform:scale(.98)}
button[style*="--g"],button[style*="--r"],button[style*="#25d366"]{border-color:transparent}
.full{width:100%}
.blk{background:var(--ink)!important;color:#fff!important;border-color:var(--ink)}
input,select,textarea{font:inherit;width:100%;min-height:60px;border:1px solid var(--line);border-radius:14px;padding:0 16px;background:#fff;color:var(--ink);margin:7px 0;outline:0;transition:.15s}
input:focus,select:focus,textarea:focus{border-color:var(--ink);box-shadow:0 0 0 4px rgba(15,23,42,.08)}
textarea{padding:16px;min-height:260px;font:16px/1.5 ui-monospace,Menlo,monospace}
label{font-size:14px;color:var(--mut);font-weight:600}
#hdr{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:14px;width:100%;margin:0;border:0;border-bottom:1px solid var(--line);border-radius:0;min-height:76px;justify-content:flex-start;padding:10px 20px;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);box-shadow:none}
#hdr b{font-size:20px;letter-spacing:.02em}
.av{width:46px;height:46px;border-radius:50%;background:#d1d5db;display:grid;place-items:center}
.live{margin-left:auto;font-size:15px;font-weight:600;background:var(--bg);padding:8px 14px;border-radius:99px}
.ok{color:#16a34a}.no{color:#dc2626}
#clock{font-size:clamp(22px,6vw,34px);font-weight:700;text-align:center;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.row{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)}.row:last-child{border:0}
.slots{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px}
.slot{padding:14px;border-radius:14px;background:var(--bg);display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;justify-content:space-between;font-size:16px}
.muted{color:var(--mut);opacity:.8}
.bd{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:99px;font-weight:600;font-size:15px}
.bd::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor}
.bd.ok{background:#dcfce7;color:#166534}.bd.no{background:#fee2e2;color:#991b1b}
.tw{overflow-x:auto;margin:0 -4px}table{width:100%;border-collapse:collapse;font-size:16px}
th{font-size:12px;letter-spacing:.1em;color:var(--mut);text-align:left;padding:8px 8px;border-bottom:1px solid var(--line)}
td{padding:12px 8px;border-bottom:1px solid var(--line);vertical-align:middle;white-space:nowrap}tr:last-child td{border:0}
.sts{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
.st{min-height:64px;margin:0;justify-content:flex-start;border:2px solid var(--line)}
.st.dis{color:#94a3b8;background:#f8fafc}
.st.act{border:4px solid;font-weight:700}.st.act.g{background:#dcfce7;border-color:var(--g);color:#14532d}.st.act.r{background:#fee2e2;border-color:var(--r);color:#7f1d1d}
.conf{font-size:20px;font-weight:700;text-align:center;padding:6px 0 16px}
.modal{position:fixed;inset:0;background:var(--bg);z-index:50;overflow:auto;padding:24px 16px;display:none}
.modal.show{display:block}
.modal:not(.ov)>*{max-width:520px;margin-left:auto;margin-right:auto}
.modal.ov{background:rgba(15,23,42,.5);backdrop-filter:blur(4px)}
.modal.ov>.box{max-width:560px;margin:7vh auto;background:#fff;border-radius:24px;padding:22px;box-shadow:0 24px 60px rgba(15,23,42,.25)}
.modal h2{font-size:16px}
.role{display:flex;gap:16px;width:100%;min-height:104px;font-size:20px;letter-spacing:.06em;margin:14px 0;border-radius:20px;justify-content:flex-start;padding:0 26px}
.role .i{width:34px;height:34px}
#foot{position:fixed;bottom:0;left:0;right:0;text-align:center;font-size:13px;color:var(--mut);padding:12px;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-top:1px solid var(--line)}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:80px;background:var(--ink);color:#fff;padding:14px 22px;border-radius:14px;z-index:99;display:none;max-width:90%;text-align:center;box-shadow:0 12px 30px rgba(15,23,42,.3)}
.ck{display:flex;align-items:center;gap:14px;min-height:60px;border-bottom:1px solid var(--line)}.ck input{width:26px;min-height:26px;margin:0;accent-color:var(--ink)}
.call{padding:16px;margin:12px 0;border-radius:16px;background:var(--bg)}
#timer{font-size:48px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
</style></head>
