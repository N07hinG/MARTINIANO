<script type="module">
import {initializeApp} from "firebase/app";
import {getFirestore,collection,doc,addDoc,updateDoc,onSnapshot,serverTimestamp,query,where,orderBy,Timestamp} from "firebase/firestore";
const firebaseConfig={apiKey:"AIzaSyCmlq-PTA4Hxllyg8MX6rnqL_kPqLGUI9s",authDomain:"martiniano-2026.firebaseapp.com",projectId:"martiniano-2026",storageBucket:"martiniano-2026.firebasestorage.app",messagingSenderId:"152476581622",appId:"1:152476581622:web:5a89a6bbdec3bda6cdb6d7"};
const db=getFirestore(initializeApp(firebaseConfig));
const $=id=>document.getElementById(id);
const I={phone:'<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',phone2:'<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>',user:'<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',users:'<circle cx="9" cy="8" r="3.5"/><path d="M2 21a7 7 0 0 1 14 0M16 4.5a3.5 3.5 0 0 1 0 7M22 21a7 7 0 0 0-4-6.3"/>',shield:'<path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/>',truck:'<path d="M1 4h13v12H1zM14 8h4l4 4v4h-8"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>',history:'<path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2"/>',clip:'<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2M9 12h6M9 16h4"/>',mic:'<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4"/>',micoff:'<path d="M2 2l20 20M9 9v2a3 3 0 0 0 5 2M15 9V5a3 3 0 0 0-5.7-1.3M5 11a7 7 0 0 0 11 5.7M19 11a7 7 0 0 1-.6 2.8M12 18v4"/>',plus:'<path d="M12 5v14M5 12h14"/>',link:'<path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>',phoneoff:'<path d="M10.7 13.3a16 16 0 0 0 3 2.3l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3M2 2l20 20"/>',logout:'<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>',send:'<path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/>',copy:'<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>'};
const ic=n=>`<svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${I[n]}</svg>`;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const MAQ=["FG18039 - GASEOSERO","FG22020 - GASEOSERO","FG22001 - CON TAPA","FG18023 - CON TAPA","FG22003 - CON TAPA","FG22032 - CON TAPA","FG22024 - CON TAPA","FG22016 - CON TAPA","FG22004 - CON TAPA","FG18022 - CON TAPA","18006","18009"];
const EST={montacarguista:["En Patio","En Charlotte","En Grifo","En Taller","En Servicios Generales","En Washing","En Tópico"],asistente:["En Patio","En Charlotte","En Tópico","En Reunión","En Capacitación"]};
EST.supervisor=EST.asistente;
const RN={supervisor:'Supervisor',asistente:'Asistente',montacarguista:'Montacarguista'};
let P=[],C=[],me=null,dbOk=false,lastEst=null,seen=new Set(),notified=new Set();

/* ---------- utilidades ---------- */
const wav=(()=>{const r=8000,n=4000,d=new DataView(new ArrayBuffer(44+n)),s=(o,t)=>[...t].forEach((c,i)=>d.setUint8(o+i,c.charCodeAt(0)));s(0,'RIFF');d.setUint32(4,36+n,true);s(8,'WAVEfmt ');d.setUint32(16,16,true);d.setUint16(20,1,true);d.setUint16(22,1,true);d.setUint32(24,r,true);d.setUint32(28,r,true);d.setUint16(32,1,true);d.setUint16(34,8,true);s(36,'data');d.setUint32(40,n,true);for(let i=0;i<n;i++)d.setUint8(44+i,128+Math.sin(i*2*Math.PI*880/r)*80);return URL.createObjectURL(new Blob([d],{type:'audio/wav'}))})();
const beep=()=>{try{new Audio(wav).play().catch(()=>{})}catch(e){}};
const toast=(m,ms=3500)=>{const t=$('toast');t.textContent=m;t.style.display='block';clearTimeout(t._t);t._t=setTimeout(()=>t.style.display='none',ms)};
const ms=t=>t&&t.toMillis?t.toMillis():Date.now();
const hm=t=>t?new Date(ms(t)).toLocaleTimeString('es-PE',{timeZone:'America/Lima',hour:'2-digit',minute:'2-digit',hour12:false}):'--:--';
const hm12=t=>new Date(ms(t)).toLocaleTimeString('es-PE',{timeZone:'America/Lima',hour:'2-digit',minute:'2-digit',hour12:true});
const isOn=p=>p.enLinea&&(!p.ultimaConexion||Date.now()-ms(p.ultimaConexion)<120000);
const ref=p=>({id:p.id,nombre:p.nombre,rol:p.rol,maquina:p.maquina||''});
const tag=p=>`${RN[p.rol]} ${p.nombre}${p.maquina?' - '+p.maquina+(p.proceso?' - '+p.proceso:''):''}`;
const lima=()=>{const f=new Intl.DateTimeFormat('en-US',{timeZone:'America/Lima',hour12:false,hour:'2-digit',day:'2-digit',month:'short',year:'2-digit'}).formatToParts(new Date()),g=t=>f.find(x=>x.type===t).value;return{h:+g('hour')%24,d:g('day')+g('month').toUpperCase()+g('year')}};
const guard=async f=>{try{return await f()}catch(e){console.error(e);toast('Error: '+(e.code||e.message))}};

/* ---------- header / reloj ---------- */
function hdr(){const on=navigator.onLine&&dbOk;$('live').innerHTML=on?'<span class="ok">● en vivo</span>':'<span class="no">● sin conexión</span>'}
addEventListener('online',hdr);addEventListener('offline',hdr);
setInterval(()=>{
 const pt=new Intl.DateTimeFormat('es-PE',{timeZone:'America/Lima',weekday:'long',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true}).formatToParts(new Date()),g=t=>(pt.find(x=>x.type===t)||{}).value||'';
 const W=g('weekday');$('clock').textContent=`${W[0].toUpperCase()+W.slice(1)} ${g('day')} ${g('month').replace('.','').replace(/^./,c=>c.toUpperCase())} - ${g('hour')}:${g('minute')}:${g('second')} ${g('dayPeriod').replace(/[ .\u00a0]/g,'').toUpperCase()}`;
 document.querySelectorAll('.ago').forEach(e=>e.textContent=`hace ${Math.max(0,Math.round((Date.now()-+e.dataset.t)/1000))} seg`);
 const t=$('timer');if(t&&joinedAt){const s=Math.floor((Date.now()-joinedAt)/1000);t.textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}
},1000);

/* ---------- listeners Firestore ---------- */
onSnapshot(collection(db,'personal'),{includeMetadataChanges:true},s=>{
 P=s.docs.map(d=>({id:d.id,...d.data()}));dbOk=!s.metadata.fromCache;
 if(me){const m=P.find(p=>p.id===me.id);if(m)me=m;if(me.estado!==lastEst)renderPanel()}
 hdr();render();
},()=>{dbOk=false;hdr()});
const d0=new Date();d0.setHours(0,0,0,0);
onSnapshot(query(collection(db,'llamadas'),where('timestamp','>=',Timestamp.fromDate(d0)),orderBy('timestamp','desc')),s=>{
 C=s.docs.map(d=>({id:d.id,...d.data()}));renderHist();if(me)handleCalls();
},e=>console.error(e));

/* ---------- dashboard ---------- */
const badge=p=>`<span class="bd ${p.estado==='En Patio'?'ok':'no'}">${esc(p.estado)}</span>`;
function render(){
 const on=P.filter(isOn);
 const sup=on.filter(p=>p.rol==='supervisor');
 $('sup').innerHTML=sup.length?sup.map(p=>`<div class="row"><b>${esc(p.nombre)}</b>${badge(p)}<small>Ingreso ${hm(p.horaIngreso)}</small></div>`).join(''):'<div class="muted">Sin supervisor en línea</div>';
 const as=on.filter(p=>p.rol==='asistente').sort((a,b)=>ms(a.horaIngreso)-ms(b.horaIngreso)).slice(0,5);
 $('asH').innerHTML=ic('users')+`ASISTENTES (${as.length}/5)`;
 $('as').innerHTML=[0,1,2,3,4].map(i=>as[i]?`<div class="slot">Asistente ${i+1}: <b>${esc(as[i].nombre)}</b> - ${esc(as[i].estado)} - ${hm(as[i].horaCambioEstado||as[i].horaIngreso)} <button data-a="call1" data-id="${as[i].id}" style="min-height:44px;padding:0 14px">${ic('phone')}</button></div>`:`<div class="slot muted">Asistente ${i+1}: Disponible</div>`).join('');
 const mo=on.filter(p=>p.rol==='montacarguista').sort((a,b)=>(a.estado==='En Patio'?0:1)-(b.estado==='En Patio'?0:1)||String(a.maquina).localeCompare(a.maquina&&b.maquina));
 $('mo').innerHTML=mo.length?mo.map(p=>{const v=p.estado==='En Patio';return`<tr><td><b>${esc(p.maquina)}</b></td><td>${esc(p.proceso||'—')}</td><td>${esc(p.nombre)}</td><td><span class="bd ${v?'ok':'no'}">${v?'En Patio - Disponible':'No Disponible desde '+hm(p.horaCambioEstado)}</span>${v?'':'<br><small>'+esc(p.estado)+'</small>'}</td><td><a class="btn" style="min-height:48px;padding:0 14px" href="tel:+51${esc(p.celular)}">${ic('phone2')}</a> <button style="min-height:48px;padding:0 14px" data-a="call1" data-id="${p.id}">${ic('phone')}</button></td></tr>`}).join(''):'<tr><td colspan="5" class="muted">Sin montacarguistas en línea</td></tr>';
}
function renderHist(){
 $('hist').innerHTML=C.length?C.slice(0,15).map(c=>`<div class="row" style="font-size:16px"><span>${hm(c.timestamp)} · ${esc(c.de.nombre)} → ${esc(c.para.nombre)}</span><b>${esc(c.estado)}</b></div>`).join(''):'<div class="muted">Sin llamadas hoy</div>';
}

/* ---------- login ---------- */
$('hdr').onclick=()=>{if(me)return toast('Ya ingresaste como '+me.nombre);roleScreen()};
function roleScreen(){$('login').classList.add('show');$('login').innerHTML=`<h2 style="text-align:center;font-size:26px">Selecciona tu rol</h2>${['supervisor','asistente','montacarguista'].map(r=>`<button class="role" data-a="role" data-r="${r}">${ic(r==='supervisor'?'shield':r==='asistente'?'user':'truck')}${RN[r].toUpperCase()}</button>`).join('')}<button class="full" data-a="closeLogin">Cancelar</button>`}
function form(r){$('login').innerHTML=`<h2 style="font-size:24px">${RN[r].toUpperCase()}</h2>
 <input id="f_n" placeholder="Nombres y Apellidos" autocomplete="off">
 ${r==='supervisor'?'<input id="f_p" type="password" placeholder="Contraseña">':''}
 ${r==='montacarguista'?`<select id="f_m"><option value="">Selecciona montacarga</option>${MAQ.map(m=>`<option>${m}</option>`).join('')}</select><input id="f_c" type="tel" inputmode="numeric" maxlength="9" placeholder="Celular (9 dígitos)">`:''}
 <div id="f_e" class="no" style="font-weight:700;min-height:28px"></div>
 <button class="full" data-a="enter" data-r="${r}" style="background:#111;color:#fff">INGRESAR</button><button class="full" data-a="roles">Atrás</button>`}
async function enter(r){
 const err=m=>$('f_e').textContent=m,n=$('f_n').value.trim().replace(/\s+/g,' ');
 if(n.split(' ').length<2)return err('Escribe nombres y apellidos');
 const data={rol:r,nombre:n,maquina:'',proceso:'',celular:'',estado:'En Patio',horaIngreso:serverTimestamp(),horaCambioEstado:serverTimestamp(),enLinea:true,ultimaConexion:serverTimestamp()};
 if(r==='supervisor'&&$('f_p').value!=='@vpo2026')return err('Contraseña incorrecta');
 if(r==='asistente'&&P.filter(p=>p.rol==='asistente'&&isOn(p)).length>=5)return err('Turno completo (5/5) - Máximo alcanzado');
 if(r==='montacarguista'){const m=$('f_m').value,c=$('f_c').value.trim();if(!m)return err('Elige un montacarga');if(!/^\d{9}$/.test(c))return err('Celular de 9 dígitos');
  const [maq,proc]=m.split(' - ');data.maquina=maq;data.proceso=proc||'';data.celular=c}
 const d=await guard(()=>addDoc(collection(db,'personal'),data));if(!d)return;
 me={id:d.id,...data,horaIngreso:Timestamp.now(),horaCambioEstado:Timestamp.now()};
 $('login').classList.remove('show');renderPanel();handleCalls();
 setInterval(()=>updateDoc(doc(db,'personal',me.id),{enLinea:true,ultimaConexion:serverTimestamp()}).catch(()=>{}),30000);
}
addEventListener('pagehide',()=>{if(me)updateDoc(doc(db,'personal',me.id),{enLinea:false}).catch(()=>{})});

/* ---------- panel personal ---------- */
function renderPanel(){
 if(!me){$('panel').innerHTML='';return}
 lastEst=me.estado;const g=me.estado==='En Patio';
 $('panel').innerHTML=`<div class="card"><h2>Hola, ${esc(me.nombre)} (${RN[me.rol]}${me.maquina?' · '+esc(me.maquina):''})</h2>
 <div class="conf" style="color:${g?'#15803d':'#b91c1c'}">Estás en: ${esc(me.estado)} a las ${hm12(me.horaCambioEstado)}</div>
 <div class="sts">${EST[me.rol].map(e=>{const a=e===me.estado;return`<button class="st ${a?'act '+(e==='En Patio'?'g':'r'):'dis'}" data-a="est" data-e="${e}">${e}</button>`}).join('')}</div></div>
 <div class="card"><h2>${ic('phone')}COMUNICACIÓN</h2><button class="full" data-a="pick" data-r="supervisor">${ic('shield')}Llamar a Supervisor</button><button class="full" data-a="pick" data-r="asistente">${ic('user')}Llamar a Asistente</button><button class="full" data-a="pick" data-r="montacarguista">${ic('truck')}Llamar a Montacarguista</button><button class="full" data-a="pick" data-r="grupal">${ic('users')}Llamada Grupal</button>
 ${me.rol==='supervisor'?'<button class="full blk" data-a="estatus">${ic('clip')}ESTATUS</button>':''}<button class="full" data-a="salir">${ic('logout')}Salir</button></div>`;
}
async function setEstado(e){
 if(e===me.estado)return;
 me.estado=e;me.horaCambioEstado=Timestamp.now();renderPanel();
 guard(()=>updateDoc(doc(db,'personal',me.id),{estado:e,horaCambioEstado:serverTimestamp(),ultimaConexion:serverTimestamp()}));
}

/* ---------- llamadas ---------- */
function pick(r){
 const list=P.filter(p=>isOn(p)&&p.id!==me.id&&(r==='grupal'||r==='add'||p.rol===r));
 const inRoom=new Set(C.filter(c=>c.salaId===curSala&&c.estado==='aceptada').flatMap(c=>[c.de.id,c.para.id]));
 const L=r==='add'?list.filter(p=>!inRoom.has(p.id)):list;
 const grp=r==='grupal';
 $('pbox').innerHTML=`<h2>${grp?'Llamada grupal: elige personas':r==='add'?'Agregar persona':'Llamar a '+RN[r]}</h2>`+(L.length?L.map(p=>grp?`<label class="ck"><input type="checkbox" value="${p.id}">${esc(tag(p))}</label>`:`<button class="full" data-a="docall" data-id="${p.id}" data-r="${r}">${esc(tag(p))}</button>`).join(''):'<div class="muted">Nadie en línea</div>')+(grp&&L.length?'<button class="full blk" data-a="grp">INICIAR LLAMADA</button>':'')+'<button class="full" data-a="closePick">Cerrar</button>';
 $('picker').classList.add('show');
}
async function createCalls(targets,sala){
 beep();
 for(const t of targets)await guard(()=>addDoc(collection(db,'llamadas'),{de:ref(me),para:ref(t),estado:'llamando',participantes:[me.id,t.id],salaId:sala,timestamp:serverTimestamp()}));
 toast('Llamando...');
}
const rid=()=>Math.random().toString(36).slice(2,10);
const setCall=(id,o)=>guard(()=>updateDoc(doc(db,'llamadas',id),o));
function handleCalls(){
 if(!me)return;
 const inc=C.filter(c=>c.para.id===me.id&&(c.estado==='llamando'||c.estado==='en-espera')).sort((a,b)=>ms(a.timestamp)-ms(b.timestamp));
 const fresh=inc.filter(c=>c.estado==='llamando'&&!seen.has(c.id));
 if(fresh.length){fresh.forEach(c=>seen.add(c.id));beep();navigator.vibrate&&navigator.vibrate([400,200,400,200,400])}
 if(inc.length){
  $('inbox').innerHTML=`<h2 style="font-size:16px">${ic('phone')}${inc.length>1?inc.length+' llamadas en cola':'Llamada entrante'}</h2>`+inc.map((c,i)=>`<div class="call"><b>${inc.length>1?(i+1)+'. ':''}${esc(RN[c.de.rol])} ${esc(c.de.nombre)}${c.de.maquina?' - '+esc(c.de.maquina):''}</b><br>Solicita comunicación · <span class="ago" data-t="${ms(c.timestamp)}"></span>${c.estado==='en-espera'?' · <b>EN ESPERA</b>':''}
  <div class="sts"><button data-a="acc" data-id="${c.id}" style="background:var(--g);color:#fff">Aceptar</button><button data-a="rej" data-id="${c.id}" style="background:var(--r);color:#fff">Rechazar</button>${c.estado==='llamando'?`<button data-a="hold" data-id="${c.id}">Poner en espera</button>`:''}</div></div>`).join('');
  $('incoming').classList.add('show');
 }else $('incoming').classList.remove('show');
 C.filter(c=>c.de.id===me.id&&c.estado==='rechazada'&&!notified.has(c.id)&&Date.now()-ms(c.timestamp)<90000).forEach(c=>{notified.add(c.id);toast(`Llamada rechazada por ${RN[c.para.rol]} ${c.para.nombre}`,5000)});
 const act=C.filter(c=>c.estado==='aceptada'&&(c.de.id===me.id||c.para.id===me.id));
 if(!act.length){if(curSala)leaveRoom()}
 else{const s=(act.find(c=>c.salaId===curSala)||act[0]).salaId;if(s!==curSala)joinRoom(s);else renderRoom()}
}

/* ---------- sala WebRTC ---------- */
let curSala=null,stream=null,peers={},unsub=null,joinedAt=0,muted=false,sim=false,chain=Promise.resolve();
const sigCol=()=>collection(db,'salas',curSala,'signals');
const sig=(para,tipo,data)=>addDoc(sigCol(),{de:me.id,para,tipo,data:data||'',ts:serverTimestamp()});
async function joinRoom(sala){
 leaveRoom(true);curSala=sala;joinedAt=Date.now();sim=false;muted=false;
 try{stream=await navigator.mediaDevices.getUserMedia({audio:true})}catch(e){stream=null;sim=true}
 if(curSala!==sala)return;
 renderRoom();$('room').classList.add('show');
 let ready=false;
 unsub=onSnapshot(sigCol(),s=>{
  if(!ready){if(s.metadata.fromCache)return;ready=true;sig('*','join');return}
  s.docChanges().forEach(ch=>{if(ch.type!=='added')return;const g=ch.doc.data();if(g.de===me.id)return;
   if(g.tipo==='join')chain=chain.then(()=>offer(g.de)).catch(console.error);
   else if(g.para===me.id)chain=chain.then(()=>onSig(g)).catch(console.error)});
 });
}
function mk(id){
 peers[id]&&peers[id].close();
 const pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});peers[id]=pc;
 if(stream)stream.getTracks().forEach(t=>pc.addTrack(t,stream));else pc.addTransceiver('audio',{direction:'recvonly'});
 pc.onicecandidate=e=>e.candidate&&sig(id,'ice',JSON.stringify(e.candidate));
 pc.ontrack=e=>{let a=$('a'+id);if(!a){a=document.createElement('audio');a.id='a'+id;a.autoplay=true;$('audios').appendChild(a)}a.srcObject=e.streams[0];a.play().catch(()=>{})};
 return pc;
}
async function offer(id){const pc=mk(id);await pc.setLocalDescription(await pc.createOffer());await sig(id,'offer',JSON.stringify(pc.localDescription))}
async function onSig(g){
 if(g.tipo==='offer'){const pc=mk(g.de);await pc.setRemoteDescription(JSON.parse(g.data));await pc.setLocalDescription(await pc.createAnswer());await sig(g.de,'answer',JSON.stringify(pc.localDescription))}
 else if(g.tipo==='answer'){const pc=peers[g.de];if(pc&&pc.signalingState==='have-local-offer')await pc.setRemoteDescription(JSON.parse(g.data))}
 else if(g.tipo==='ice'){try{await peers[g.de]?.addIceCandidate(JSON.parse(g.data))}catch(e){}}
}
function leaveRoom(keep){
 unsub&&unsub();unsub=null;Object.values(peers).forEach(p=>p.close());peers={};
 stream&&stream.getTracks().forEach(t=>t.stop());stream=null;$('audios').innerHTML='';
 curSala=null;joinedAt=0;if(!keep)$('room').classList.remove('show');
}
function renderRoom(){
 if(!curSala)return;
 const docs=C.filter(c=>c.salaId===curSala&&c.estado==='aceptada'),m=new Map();
 docs.forEach(c=>{m.set(c.de.id,c.de);m.set(c.para.id,c.para)});
 const wait=C.filter(c=>c.para.id===me.id&&c.estado==='en-espera').length;
 $('room').innerHTML=`<h2 style="justify-content:center">${ic('mic')}Llamada en vivo</h2><div id="timer" class="conf">00:00</div>
 ${sim?'<div class="conf muted" style="font-size:16px">Sin permiso de micrófono: simulación conectada</div>':''}
 <div class="card">${[...m.values()].map(p=>`<div class="row"><b>${esc(p.nombre)}${p.id===me.id?' (tú)':''}</b><span>${esc(RN[p.rol])}${p.maquina?' · '+esc(p.maquina):''}</span></div>`).join('')}</div>
 <button class="full" data-a="mute">${muted?ic('micoff')+'Activar mic':ic('mic')+'Silenciar mic'}</button>
 <button class="full" data-a="add">${ic('plus')}Agregar persona</button>
 ${wait?`<button class="full" data-a="merge">${ic('link')}Unir llamadas en espera (${wait})</button>`:''}
 <button class="full" data-a="hang" style="background:var(--r);color:#fff">${ic('phoneoff')}Colgar</button>`;
}

/* ---------- ESTATUS ---------- */
function buildEst(){
 const L=lima(),t=L.h>=6&&L.h<14?'T1':L.h>=14&&L.h<22?'T2':'T3',pad=n=>String(n).padStart(2,'0');
 const on=P.filter(isOn),as=on.filter(p=>p.rol==='asistente'),mo=on.filter(p=>p.rol==='montacarguista');
 const ab=n=>{const w=n.trim().split(/\s+/);return w[0][0].toUpperCase()+'. '+(w.length>=4?w[2]:w[Math.min(1,w.length-1)])};
 const code=p=>p.maquina.replace(/^FG-?/,'');
 const lines=mo.sort((a,b)=>code(a).localeCompare(code(b))).map(p=>`FG-${code(p)}. ${ab(p.nombre)}`).join('\n');
 const ta=+$('e_a').value||0,tm=+$('e_m').value||0;
 $('e_t').value=`*ASISTENCIA ${t}*\n*${L.d}*\n*Supervisor*\n${me.nombre}\n\n*Asistentes ${pad(as.length)}/${pad(ta)}*\n${as.map(p=>p.nombre).join('\n')}\n\n*Montacarguistas ${pad(mo.length)}/${pad(tm)}*\n${lines}`;
}
function openEst(){
 $('est').innerHTML=`<h2>${ic('clip')}ESTATUS</h2><label>Asistentes esperados</label><input id="e_a" type="number" value="2" min="0"><label>Montacarguistas esperados</label><input id="e_m" type="number" value="8" min="0"><textarea id="e_t"></textarea>
 <button class="full" data-a="copy">${ic('copy')}Copiar Texto</button><button class="full" data-a="wa" style="background:#25d366;color:#fff">${ic('send')}Enviar por WhatsApp</button>
 <input id="e_c" type="tel" inputmode="numeric" maxlength="9" placeholder="Celular (9 dígitos)"><button class="full" data-a="wan">${ic('phone')}Enviar a número específico</button><button class="full" data-a="closeEst">Cerrar</button>`;
 $('est').classList.add('show');buildEst();$('e_a').oninput=$('e_m').oninput=buildEst;
}

/* ---------- eventos ---------- */
document.addEventListener('click',async ev=>{
 const b=ev.target.closest('[data-a]');if(!b)return;const a=b.dataset.a,id=b.dataset.id,r=b.dataset.r;
 if(a==='hdr')return;
 if(a==='role')form(r);else if(a==='roles')roleScreen();else if(a==='closeLogin')$('login').classList.remove('show');
 else if(a==='enter')enter(r);
 else if(a==='est')setEstado(b.dataset.e);
 else if(a==='salir'){await guard(()=>updateDoc(doc(db,'personal',me.id),{enLinea:false}));leaveRoom();me=null;renderPanel();location.reload()}
 else if(a==='pick'){if(!me)return toast('Ingresa primero');pick(r)}
 else if(a==='call1'){if(!me)return toast('Ingresa primero (toca el encabezado)');const p=P.find(x=>x.id===id);if(p&&p.id!==me.id)createCalls([p],rid())}
 else if(a==='docall'){$('picker').classList.remove('show');createCalls([P.find(x=>x.id===id)],r==='add'?curSala:rid())}
 else if(a==='grp'){const ids=[...document.querySelectorAll('#pbox input:checked')].map(i=>i.value);if(!ids.length)return toast('Elige al menos una persona');$('picker').classList.remove('show');createCalls(ids.map(i=>P.find(p=>p.id===i)),rid())}
 else if(a==='closePick')$('picker').classList.remove('show');
 else if(a==='acc')setCall(id,{estado:'aceptada'});
 else if(a==='rej')setCall(id,{estado:'rechazada'});
 else if(a==='hold')setCall(id,{estado:'en-espera'});
 else if(a==='mute'){muted=!muted;stream&&stream.getAudioTracks().forEach(t=>t.enabled=!muted);renderRoom()}
 else if(a==='add')pick('add');
 else if(a==='merge')C.filter(c=>c.para.id===me.id&&c.estado==='en-espera').forEach(c=>setCall(c.id,{estado:'aceptada',salaId:curSala}));
 else if(a==='hang'){const s=curSala;C.filter(c=>c.salaId===s&&c.estado==='aceptada'&&(c.de.id===me.id||c.para.id===me.id)).forEach(c=>setCall(c.id,{estado:'finalizada'}));leaveRoom()}
 else if(a==='estatus')openEst();else if(a==='closeEst')$('est').classList.remove('show');
 else if(a==='copy'){try{await navigator.clipboard.writeText($('e_t').value);toast('Texto copiado')}catch(e){$('e_t').select();toast('Selecciona y copia manualmente')}}
 else if(a==='wa')window.open(`https://wa.me/?text=${encodeURIComponent($('e_t').value)}`,'_blank');
 else if(a==='wan'){const c=$('e_c').value.trim();if(!/^\d{9}$/.test(c))return toast('Celular de 9 dígitos');window.open(`https://wa.me/51${c}?text=${encodeURIComponent($('e_t').value)}`,'_blank')}
});
document.querySelectorAll('[data-i]').forEach(e=>e.innerHTML=ic(e.dataset.i));
hdr();render();renderHist();
</script></body></html>
